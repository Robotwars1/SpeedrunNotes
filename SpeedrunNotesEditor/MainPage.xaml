<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SpeedrunNotesEditor"
             x:Class="SpeedrunNotesEditor.MainPage"
             x:DataType="local:MainPage"
             Background="#121212" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TabBar for selecting split to edit 
             Frame is workaround to put padding around the collectionview -->
        <!-- No bottom margin to avoid double-stacked spacing -->
        <Frame Margin="10, 10, 10, 0"
               Padding="0"
               BackgroundColor="#000000ff">
            <CollectionView x:Name="SplitSelector"
                            Grid.ColumnSpan="2"
                            HorizontalScrollBarVisibility="Never"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectedIndexChanged"
                            ItemsSource="{Binding SplitTitles}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="2"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Frame BackgroundColor="#404040"
                               CornerRadius="5"
                               Padding="5">
                            <Label Text="{Binding .}"
                                   VerticalTextAlignment="Center"
                                   FontSize="20"
                                   LineBreakMode="NoWrap"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#323232" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#484848" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>

        <Grid Grid.Row="1"
              Padding="10"
              RowSpacing="10"
              ColumnSpacing="10"
              RowDefinitions="*, *, *, *"
              ColumnDefinitions="2*, 4*">
            <Frame Padding="8"
                   BorderColor="#323232"
                   BackgroundColor="#323232">
                <Grid RowDefinitions="*, 3*">
                    <Label Text="Split Name"
                           FontSize="25" />

                    <Entry x:Name="SplitNameEntry"
                           ClassId="0"
                           Grid.Row="1"
                           IsEnabled="false"
                           TextChanged="OnTextChanged" />
                </Grid>
            </Frame>

            <Frame Padding="8"
                   BorderColor="#323232"
                   BackgroundColor="#323232"
                   Grid.Row="1"
                   Grid.RowSpan="2">
                <Grid RowDefinitions="*, 3*, *">
                    <Label Text="Split Image"
                           FontSize="25" />

                    <Image x:Name="SplitTitleImage"
                           Grid.Row="1"/>

                    <Button x:Name="SplitTitleImageButton"
                            Text="Select Image"
                            Grid.Row="2" 
                            IsEnabled="false"
                            ClassId="0"
                            Clicked="OnImageSelectButtonClicked" />
                </Grid>
            </Frame>

            <Frame Padding="8"
                   BorderColor="#323232"
                   BackgroundColor="#323232"
                   Grid.Row="3">
                <Grid RowDefinitions="*, 3*">
                    <Label Text="Template Name"
                           FontSize="25" />

                    <Entry x:Name="TemplateNameEntry"
                           ClassId="0"
                           Grid.Row="1"
                           IsEnabled="false"
                           TextChanged="OnTemplateNameChanged" />
                </Grid>
            </Frame>

            <Frame Padding="8"
                   BorderColor="#323232"
                   BackgroundColor="#323232"
                   Grid.Column="1"
                   Grid.RowSpan="2">
                <Grid RowSpacing="5"
                      ColumnSpacing="5"
                      RowDefinitions="*, 5*, *"
                      ColumnDefinitions="*, *">
                    <Label Text="Split Notes 1"
                           FontSize="25" />

                    <Editor x:Name="SplitNote1TextEditor"
                            ClassId="1"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            IsEnabled="false"
                            TextChanged="OnTextChanged" />

                    <Image x:Name="SplitNote1Image"
                           Grid.Row="1"
                           Grid.Column="1"/>

                    <Button x:Name="SplitNote1ImageButton"
                            Text="Select Image"
                            Grid.Row="2"
                            Grid.Column="1"
                            IsEnabled="false"
                            ClassId="1"
                            Clicked="OnImageSelectButtonClicked" />
                </Grid>
            </Frame>

            <Frame Padding="8"
                   BorderColor="#323232"
                   BackgroundColor="#323232"
                   Grid.Column="1"
                   Grid.Row="2"
                   Grid.RowSpan="2">
                <Grid RowSpacing="5"
                      ColumnSpacing="5"
                      RowDefinitions="*, 5*, *"
                      ColumnDefinitions="*, *">
                    <Label Text="Split Notes 2"
                           FontSize="25" />

                    <Editor x:Name="SplitNote2TextEditor"
                            ClassId="2"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            IsEnabled="false"
                            TextChanged="OnTextChanged" />

                    <Image x:Name="SplitNote2Image"
                           Grid.Row="1"
                           Grid.Column="1"/>

                    <Button x:Name="SplitNote2ImageButton"
                            Text="Select Image"
                            Grid.Row="2"
                            Grid.Column="1"
                            IsEnabled="false"
                            ClassId="2"
                            Clicked="OnImageSelectButtonClicked" />
                </Grid>
            </Frame>
        </Grid>

        <local:SaveIndicator x:Name="FileSaveIndicator"
                             VerticalOptions="End"
                             HorizontalOptions="Start"
                             Padding="5"
                             Grid.Row="2"
                             IsVisible="False" />

        <!-- Side-bar -->
        <Frame x:Name="Sidebar"
               VerticalOptions="End"
               HorizontalOptions="End"
               WidthRequest="200"
               Padding="0"
               Grid.RowSpan="2"
               BackgroundColor="#323232">
            <Grid ColumnDefinitions="50, *"
                  RowDefinitions="30, 50, 50, 10, 50, 50">
                <ImageButton x:Name="ToggleSidebarButton"
                             Source="close_sidebar.png"
                             BackgroundColor="#323232"
                             Grid.RowSpan="6"
                             WidthRequest="50"
                             VerticalOptions="Center"
                             Clicked="ToggleSidebar" />

                <Label Text="New Template"
                       FontSize="20"
                       Grid.Column="1"
                       HorizontalOptions="Center" />

                <Button Text="Empty"
                        Grid.Column="1"
                        Grid.Row="1"
                        WidthRequest="120"
                        Clicked="OnCreateEmptyClicked"/>

                <Button Text="From Splits"
                        Grid.Column="1"
                        Grid.Row="2"
                        WidthRequest="120"
                        Clicked="OnCreateFromSplitClicked" />

                <Button x:Name="SaveButton"
                        Text="Save"
                        Grid.Column="1"
                        Grid.Row="4"
                        WidthRequest="120"
                        IsEnabled="False"
                        Clicked="OnSaveTemplateClicked" />

                <Button Text="Load"
                        WidthRequest="120"
                        Grid.Column="1"
                        Grid.Row="5"
                        Clicked="OnLoadFromTemplateClicked" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
