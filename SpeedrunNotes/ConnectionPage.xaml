<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedrunNotes.ConnectionPage"
             Background="#121212"
             Appearing="OnConnectionPageAppearing" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
            <RowDefinition Height="40" />
            <RowDefinition Height="240" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <!-- Elements to show ConnectionError -->
        <Border x:Name="ConnectionErrorBackground"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0, 10"
                IsVisible="False"
                StrokeShape="RoundRectangle 10,10,10,10"
                BackgroundColor="#d9be11"
                Stroke="#d9be11" >
            <Label TextColor="Black"
                   Text="ConnectionError"
                   FontSize="20"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Connection Stuff -->
        <Frame Grid.Row="2"
               Grid.RowSpan="3"
               Grid.Column="1"
               BackgroundColor="#242424"
               BorderColor="#242424"
               CornerRadius="10">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center" >
                <Label Grid.Row="2"
                       Grid.Column="2"
                       Grid.ColumnSpan="2"
                       VerticalOptions="End"
                       Text="Local IP" 
                       FontSize="20" />

                <HorizontalStackLayout>
                    <Entry x:Name="IPEntry"
                           Grid.Row="3"
                           Grid.Column="2"
                           WidthRequest="200"
                           TextChanged="OnIpChanged" />

                    <ImageButton Grid.Row="3"
                                 Grid.Column="3"
                                 HorizontalOptions="End"
                                 Source="reset.png"
                                 WidthRequest="50"
                                 Clicked="OnIpResetButtonClicked" />
                </HorizontalStackLayout>

                <Label HeightRequest="8"/>

                <Label Grid.Row="4"
                       Grid.Column="2"
                       Grid.ColumnSpan="2"
                       VerticalOptions="End"
                       Text="Port"
                       FontSize="20" />

                <HorizontalStackLayout>
                    <Entry x:Name="PortEntry"
                           Grid.Row="5"
                           Grid.Column="2"
                           WidthRequest="200"
                           TextChanged="OnPortChanged" />

                    <ImageButton Grid.Row="5"
                                 Grid.Column="3"
                                 HorizontalOptions="End"
                                 Source="reset.png"
                                 WidthRequest="50"
                                 Clicked="OnPortResetButtonClicked" />
                </HorizontalStackLayout>

                <Button x:Name="ConnectButton"
                        Grid.Row="7"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Margin="10"
                        WidthRequest="150"
                        Text="Connect"
                        FontSize="20" 
                        Clicked="OnConnectButtonClicked" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
